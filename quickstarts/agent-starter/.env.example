# Choose one: mock | openai | anthropic | ollama
SAZAN_PROVIDER=mock

# Optional model override. Examples:
# SAZAN_MODEL=gpt-5.6
# SAZAN_MODEL=claude-sonnet-5
# SAZAN_MODEL=llama3.2

# Cloud provider credentials. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
